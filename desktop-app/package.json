{
  "name": "sandveld-vee-dienste",
  "version": "1.0.2",
  "description": "Professional livestock management and financial CRM for Sandveld Vee Dienste",
  "main": "index.js",
  "scripts": {
    "electron:dev": "electron .",
    "frontend:dev": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run frontend:dev\" \"npm run electron:dev\"",
    "build": "cd frontend && npm run build",
    "package": "npm run build && node scripts/build-installer.js",
    "release": "npm run build && node scripts/build-installer.js --publish"
  },
  "keywords": [],
  "author": "Sandveld Vee Dienste",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^44.4.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.50.0",
    "axios": "^1.7.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.26.0"
  },
  "build": {
    "appId": "com.sandveldveedienste.app",
    "productName": "Sandveld Vee Dienste",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${name}-Setup-${version}.${ext}",
      "license": "frontend/src/legal/EULA.txt"
    },
    "files": [
      "**/*",
      "!frontend/node_modules",
      "!frontend/src",
      "!scripts"
    ],
    "extraResources": [
      {
        "from": "backend/sandveld-backend",
        "to": "backend/sandveld-backend"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Christiaan2585",
      "repo": "Chriscode"
    },
    "copyright": "Copyright (c) 2026 Sandveld Vee Dienste. All rights reserved."
  }
}
